<script>
  /* =========================================================
     DETERMINISTIC RANDOM HELPERS
  ========================================================= */
  function mulberry32(seed){
    return function(){
      seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function seededRandom(seed){ const x = Math.sin(seed) * 10000; return x - Math.floor(x); }

  /* =========================================================
     STATIC LOOKUPS
  ========================================================= */
  const BRANCHES = ["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering","Electrical Engineering","Electronics & Telecommunication","AI & Data Science"];
  const CATEGORIES = ["GOPEN","OBC","EWS","SC","ST"];
  const YEARS = [2020,2021,2022,2023,2024,2025,2026];
  const branchWeights = { "Computer Engineering":5, "Information Technology":4, "Mechanical Engineering":4, "Civil Engineering":3, "Electrical Engineering":3, "Electronics & Telecommunication":3, "AI & Data Science":2 };

  const REGION_CITIES = {
    "Mumbai": ["Mumbai","Thane","Navi Mumbai","Kalyan","Vasai-Virar"],
    "Pune": ["Pune","Pimpri-Chinchwad","Baramati","Talegaon"],
    "Nashik": ["Nashik","Malegaon","Niphad"],
    "Western Maharashtra": ["Kolhapur","Satara","Sangli","Solapur","Karad","Ichalkaranji"],
    "Marathwada": ["Chh. Sambhajinagar","Nanded","Latur","Beed","Jalna","Parbhani","Hingoli","Dharashiv"],
    "Vidarbha": ["Nagpur","Amravati","Akola","Yavatmal","Wardha","Chandrapur","Gondia","Bhandara","Buldhana"],
    "Khandesh": ["Jalgaon","Dhule","Nandurbar","Bhusawal"],
    "Konkan": ["Raigad","Ratnagiri","Sindhudurg","Palghar","Alibaug"]
  };
  const REGION_TARGETS = { "Mumbai":70, "Pune":90, "Nashik":30, "Western Maharashtra":60, "Marathwada":50, "Vidarbha":60, "Khandesh":20, "Konkan":20 };
  const FOUNDERS = ["Shri Sant Gadge Baba","Sinhgad","Bharati Vidyapeeth","JSPM","MET","SVERI","Guru Nanak","Padmashri Vikhe Patil","Loknete Gopinathji Munde","Annasaheb Dange","Sanjivani","Matoshri","Zeal","Trinity","Vidya Pratishthan","Rajarshi Shahu","Vishwakarma","Adarsh","Genba Sopanrao Moze","Sandip","AISSMS","Fr. C. Rodrigues","Ramrao Adik","PES","Vishwabharati","Dr. D. Y. Patil","Pravara Rural","Yashwantrao Chavan","Shreeyash","Anuradha","Amrutvahini","Terna","Rajarambapu"];
  const SUFFIXES = ["College of Engineering","Institute of Technology","College of Engineering & Technology","Institute of Engineering & Management","Institute of Engineering","College of Engineering & Research","Institute of Technology & Management"];

  function weightedSampleBranches(count, rng){
    const pool = BRANCHES.map(b => ({ b, w: branchWeights[b] * (0.6 + rng()) }));
    pool.sort((a,b) => b.w - a.w);
    return pool.slice(0, count).map(p => p.b);
  }

  /* =========================================================
     COLLEGE DATASET — 14 real, well-known anchor colleges
     plus ~386 procedurally generated ones so every region of
     Maharashtra is represented at a realistic scale.
  ========================================================= */
  const ANCHOR_COLLEGES = [
    { code:"ENG-001", name:"Veermata Jijabai Technological Institute", city:"Mumbai", region:"Mumbai", ownership:"Government", tier:1,
      courses:["Computer Engineering","Electronics & Telecommunication","Mechanical Engineering","Information Technology"] },
    { code:"ENG-002", name:"Sardar Patel College of Engineering", city:"Mumbai", region:"Mumbai", ownership:"Government", tier:2,
      courses:["Computer Engineering","Information Technology","Electrical Engineering","Mechanical Engineering"] },
    { code:"ENG-003", name:"College of Engineering Pune Technological University", city:"Pune", region:"Pune", ownership:"Government", tier:1,
      courses:["Computer Engineering","Information Technology","AI & Data Science","Mechanical Engineering","Civil Engineering","Electrical Engineering"] },
    { code:"ENG-004", name:"Pune Institute of Computer Technology", city:"Pune", region:"Pune", ownership:"Autonomous / Aided", tier:2,
      courses:["Computer Engineering","Information Technology","Electronics & Telecommunication","AI & Data Science"] },
    { code:"ENG-005", name:"K. K. Wagh Institute of Engineering Education & Research", city:"Nashik", region:"Nashik", ownership:"Autonomous / Aided", tier:3,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering","Electronics & Telecommunication"] },
    { code:"ENG-006", name:"Government College of Engineering, Nashik", city:"Nashik", region:"Nashik", ownership:"Government", tier:2,
      courses:["Computer Engineering","Electrical Engineering","Mechanical Engineering","Civil Engineering"] },
    { code:"ENG-007", name:"Walchand College of Engineering", city:"Sangli", region:"Western Maharashtra", ownership:"Government", tier:2,
      courses:["Computer Engineering","Mechanical Engineering","Civil Engineering","Electrical Engineering","Information Technology"] },
    { code:"ENG-008", name:"Kolhapur Institute of Technology", city:"Kolhapur", region:"Western Maharashtra", ownership:"Private Unaided", tier:3,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering"] },
    { code:"ENG-009", name:"Government College of Engineering, Aurangabad", city:"Chh. Sambhajinagar", region:"Marathwada", ownership:"Government", tier:2,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Electronics & Telecommunication"] },
    { code:"ENG-010", name:"Shri Guru Gobind Singhji Institute of Engineering & Technology", city:"Nanded", region:"Marathwada", ownership:"Autonomous / Aided", tier:1,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering","Electrical Engineering"] },
    { code:"ENG-011", name:"Yeshwantrao Chavan College of Engineering", city:"Nagpur", region:"Vidarbha", ownership:"Private Unaided", tier:3,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering"] },
    { code:"ENG-012", name:"Government College of Engineering, Amravati", city:"Amravati", region:"Vidarbha", ownership:"Government", tier:2,
      courses:["Computer Engineering","Electrical Engineering","Mechanical Engineering","Civil Engineering"] },
    { code:"ENG-013", name:"Government College of Engineering, Jalgaon", city:"Jalgaon", region:"Khandesh", ownership:"Government", tier:2,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering"] },
    { code:"ENG-014", name:"Dr. Babasaheb Ambedkar Technological University", city:"Lonere, Raigad", region:"Konkan", ownership:"Government", tier:2,
      courses:["Computer Engineering","Information Technology","Mechanical Engineering","Civil Engineering","Electronics & Telecommunication"] },
  ];

  function buildColleges(){
    const list = [...ANCHOR_COLLEGES];
    const anchorCounts = {};
    ANCHOR_COLLEGES.forEach(a => { anchorCounts[a.region] = (anchorCounts[a.region]||0) + 1; });

    const rng = mulberry32(20260822);
    let codeNum = ANCHOR_COLLEGES.length + 1;

    Object.keys(REGION_TARGETS).forEach(region => {
      const need = REGION_TARGETS[region] - (anchorCounts[region] || 0);
      const cities = REGION_CITIES[region];
      for (let i = 0; i < need; i++){
        const city = cities[Math.floor(rng() * cities.length)];
        const ownRoll = rng();
        let ownership, tier;
        if (ownRoll < 0.10){ ownership = "Government"; tier = 1 + Math.floor(rng()*2); }
        else if (ownRoll < 0.28){ ownership = "Autonomous / Aided"; tier = 2 + Math.floor(rng()*2); }
        else { ownership = "Private Unaided"; tier = 3 + Math.floor(rng()*3); }

        const founder = FOUNDERS[Math.floor(rng()*FOUNDERS.length)];
        const suffix = SUFFIXES[Math.floor(rng()*SUFFIXES.length)];
        const name = ownership === "Government" ? `Government ${suffix}, ${city}` : `${founder} ${suffix}, ${city}`;

        const courseCount = 3 + Math.floor(rng()*3);
        const courses = weightedSampleBranches(courseCount, rng);

        list.push({ code:`ENG-${String(codeNum).padStart(3,'0')}`, name, city, region, ownership, tier, courses });
        codeNum++;
      }
    });
    return list;
  }

  const COLLEGES = buildColleges();

  /* =========================================================
     CUTOFF + PERCENTILE GENERATION
  ========================================================= */
  const TIER_FACTOR = { 1:1, 2:2, 3:3.5, 4:5.5, 5:7.5 };
  function baseRank(tier, branchIdx){
    const collegeFactor = TIER_FACTOR[tier] || 5;
    const branchFactor = [1,1.3,2.4,3,2.1,1.6,1.1][branchIdx] || 2;
    return Math.round(400 * collegeFactor * branchFactor);
  }
  const categoryMultiplier = { GOPEN:1, EWS:1.25, OBC:1.6, SC:2.6, ST:3.4 };

  function candidatePoolForYear(year){ return Math.round(950000 * (1 + (year - 2020) * 0.012)); }
  function rankToPercentile(rank, year){
    const pool = candidatePoolForYear(year);
    let pct = 100 - (rank / pool) * 100;
    pct = Math.max(0, Math.min(99.99, pct));
    return pct.toFixed(2);
  }

  const CUTOFFS = [];
  let seedN = 0;
  COLLEGES.forEach((college, ci) => {
    college.courses.forEach((courseName) => {
      const bi = BRANCHES.indexOf(courseName);
      if (bi === -1) return;
      YEARS.forEach((year, yi) => {
        CATEGORIES.forEach((cat, cati) => {
          seedN++;
          const noise = 0.85 + seededRandom(seedN * 12.9898) * 0.35;
          const yearTrend = 1 + (year - 2020) * 0.035;
          const rank = Math.max(15, Math.round(baseRank(college.tier, bi) * categoryMultiplier[cat] * noise * yearTrend));
          CUTOFFS.push({
            year, collegeCode: college.code, collegeName: college.name, region: college.region,
            branch: courseName, category: cat, closingRank: rank, percentile: rankToPercentile(rank, year)
          });
        });
      });
    });
  });

  document.getElementById('statColleges').textContent = COLLEGES.length + '+';

  /* =========================================================
     NAVIGATION
  ========================================================= */
  let selectedYear = null;
  let selectedBranch = null;

  function showView(id){
    document.querySelectorAll('.view').forEach(v => v.hidden = true);
    document.getElementById(id).hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    closeAllPanels();
  }

  document.getElementById('brandBtn').addEventListener('click', () => showView('view-home'));
  document.querySelectorAll('[data-target]').forEach(btn => {
    btn.addEventListener('click', () => showView(btn.getAttribute('data-target')));
  });
  document.querySelectorAll('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => showView(btn.getAttribute('data-back')));
  });

  /* =========================================================
     TOP-RIGHT PANELS
  ========================================================= */
  const panels = {
    notifBtn: document.getElementById('notifPanel'),
    updatesBtn: document.getElementById('updatesPanel'),
    settingsBtn: document.getElementById('settingsPanel'),
  };
  function closeAllPanels(){
    Object.values(panels).forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.icon-btn').forEach(b => b.classList.remove('is-active'));
  }
  Object.keys(panels).forEach(btnId => {
    const btn = document.getElementById(btnId);
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = panels[btnId].classList.contains('open');
      closeAllPanels();
      if (!isOpen){ panels[btnId].classList.add('open'); btn.classList.add('is-active'); }
    });
  });
  document.addEventListener('click', closeAllPanels);
  document.querySelectorAll('.panel').forEach(p => p.addEventListener('click', e => e.stopPropagation()));

  const lightBtn = document.getElementById('lightBtn');
  const darkBtn = document.getElementById('darkBtn');
  function setTheme(mode){
    document.documentElement.setAttribute('data-theme', mode);
    lightBtn.classList.toggle('active', mode === 'light');
    darkBtn.classList.toggle('active', mode === 'dark');
  }
  lightBtn.addEventListener('click', () => setTheme('light'));
  darkBtn.addEventListener('click', () => setTheme('dark'));
  setTheme('light');

  /* =========================================================
     SHARED TABLE ROW RENDERER
  ========================================================= */
  function rowsHTML(rows, includeBranch, eligibleFn){
    if (rows.length === 0){
      const cols = includeBranch ? 6 : 4;
      return `<tr class="empty-row"><td colspan="${cols}">No results match these filters.</td></tr>`;
    }
    return rows.map(r => {
      const eligible = eligibleFn ? eligibleFn(r) : false;
      const branchCell = includeBranch ? `<td>${r.branch}</td>` : '';
      const statusCell = includeBranch ? `<td>${eligible ? '<span class="pill eligible-pill">Eligible</span>' : '—'}</td>` : '';
      return `<tr class="${eligible ? 'eligible' : ''}">
        <td>${r.collegeName} <span class="mono" style="color:var(--ink-faint);font-size:12px;">${r.collegeCode}</span></td>
        ${branchCell}
        <td><span class="pill">${r.category}</span></td>
        <td class="rank-cell">${r.closingRank.toLocaleString('en-IN')}</td>
        <td class="pct-cell">${r.percentile}%ile</td>
        ${statusCell}
      </tr>`;
    }).join('');
  }

  /* =========================================================
     CET RANK CHECK VIEW
  ========================================================= */
  const yearCheckInput = document.getElementById('yearCheckInput');
  [...YEARS].reverse().forEach(y => yearCheckInput.appendChild(new Option(y, y)));

  const rcFilterBranch = document.getElementById('rcFilterBranch');
  rcFilterBranch.appendChild(new Option('All branches','ALL'));
  BRANCHES.forEach(b => rcFilterBranch.appendChild(new Option(b, b)));
  const rcFilterSearch = document.getElementById('rcFilterSearch');

  let currentRankCheck = null;

  function renderRankCheckTable(){
    const tbody = document.getElementById('rcTableBody');
    const branchVal = rcFilterBranch.value;
    const searchVal = rcFilterSearch.value.trim().toLowerCase();
    const year = currentRankCheck ? currentRankCheck.year : parseInt(yearCheckInput.value, 10);
    const cat = currentRankCheck ? currentRankCheck.category : null;

    let rows = CUTOFFS.filter(r => r.year === year);
    if (cat) rows = rows.filter(r => r.category === cat);
    if (branchVal !== 'ALL') rows = rows.filter(r => r.branch === branchVal);
    if (searchVal) rows = rows.filter(r => (r.collegeName + ' ' + r.branch).toLowerCase().includes(searchVal));
    rows.sort((a,b) => a.closingRank - b.closingRank);
    const total = rows.length;
    rows = rows.slice(0, 200);

    tbody.innerHTML = rowsHTML(rows, true, (r) => currentRankCheck ? currentRankCheck.rank <= r.closingRank : false);
    document.getElementById('rcResultCount').textContent = `${total.toLocaleString('en-IN')} matching listings` + (total > 200 ? ' (showing top 200 by closing rank)' : '');
  }

  document.getElementById('checkBtn').addEventListener('click', () => {
    const rankVal = parseInt(document.getElementById('rankInput').value, 10);
    const catVal = document.getElementById('catInput').value;
    const yearVal = parseInt(yearCheckInput.value, 10);
    const hint = document.getElementById('checkerHint');

    if (!rankVal || rankVal < 1){
      hint.innerHTML = 'Enter a valid rank number first.';
      currentRankCheck = null;
      renderRankCheckTable();
      return;
    }
    currentRankCheck = { rank: rankVal, category: catVal, year: yearVal };
    const matchCount = CUTOFFS.filter(r => r.category === catVal && r.year === yearVal && rankVal <= r.closingRank).length;
    hint.innerHTML = `Rank <b>${rankVal.toLocaleString('en-IN')}</b> (${catVal}, ${yearVal}) qualifies for <b>${matchCount.toLocaleString('en-IN')}</b> college-branch combinations — highlighted below.`;
    renderRankCheckTable();
  });
  rcFilterBranch.addEventListener('change', renderRankCheckTable);
  rcFilterSearch.addEventListener('input', renderRankCheckTable);
  yearCheckInput.addEventListener('change', renderRankCheckTable);
  renderRankCheckTable();

  /* =========================================================
     PY CUTOFF: YEARS -> BRANCHES -> LIST
  ========================================================= */
  document.getElementById('yearsScaleNote').textContent = `Covering ${COLLEGES.length}+ colleges across all 8 regions of Maharashtra.`;

  const yearGrid = document.getElementById('yearGrid');
  [...YEARS].reverse().forEach(y => {
    const card = document.createElement('button');
    card.className = 'pick-card';
    const count = CUTOFFS.filter(r => r.year === y).length;
    card.innerHTML = `<div class="big">${y}</div><div class="sub">${count.toLocaleString('en-IN')} listings</div>`;
    card.addEventListener('click', () => openYear(y));
    yearGrid.appendChild(card);
  });

  function openYear(year){
    selectedYear = year;
    document.getElementById('branchYearLabel').textContent = year;
    const branchGrid = document.getElementById('branchGrid');
    branchGrid.innerHTML = '';
    BRANCHES.forEach(b => {
      const count = CUTOFFS.filter(r => r.year === year && r.branch === b).length;
      if (count === 0) return;
      const card = document.createElement('button');
      card.className = 'pick-card branch-card';
      card.innerHTML = `<div class="big">${b}</div><div class="sub">${count.toLocaleString('en-IN')} listings</div>`;
      card.addEventListener('click', () => openBranch(b));
      branchGrid.appendChild(card);
    });
    showView('view-pycutoff-branches');
  }

  function openBranch(branch){
    selectedBranch = branch;
    document.getElementById('listYearLabel').textContent = selectedYear;
    document.getElementById('listBranchLabel').textContent = branch;
    document.getElementById('listFilterCategory').value = 'ALL';
    document.getElementById('listFilterSearch').value = '';
    renderListTable();
    showView('view-pycutoff-list');
  }

  function renderListTable(){
    const tbody = document.getElementById('listTableBody');
    const catVal = document.getElementById('listFilterCategory').value;
    const searchVal = document.getElementById('listFilterSearch').value.trim().toLowerCase();

    let rows = CUTOFFS.filter(r => r.year === selectedYear && r.branch === selectedBranch);
    if (catVal !== 'ALL') rows = rows.filter(r => r.category === catVal);
    if (searchVal) rows = rows.filter(r => r.collegeName.toLowerCase().includes(searchVal));
    rows.sort((a,b) => a.closingRank - b.closingRank);
    const total = rows.length;
    rows = rows.slice(0, 300);

    tbody.innerHTML = rowsHTML(rows, false, null);
    document.getElementById('listResultCount').textContent = `${total.toLocaleString('en-IN')} institutes listed` + (total > 300 ? ' (showing top 300 by closing rank)' : '');
  }
  document.getElementById('listFilterCategory').addEventListener('change', renderListTable);
  document.getElementById('listFilterSearch').addEventListener('input', renderListTable);

  /* =========================================================
     COLLEGE DIRECTORY (best to lowest within a region)
  ========================================================= */
  document.getElementById('collegesScaleNote').textContent = `${COLLEGES.length} colleges listed across Mumbai, Pune, Nashik, Western Maharashtra, Marathwada, Vidarbha, Khandesh and Konkan.`;

  const collegeRegionFilter = document.getElementById('collegeRegionFilter');
  const regions = ['ALL', ...Object.keys(REGION_TARGETS)];
  regions.forEach(r => collegeRegionFilter.appendChild(new Option(r === 'ALL' ? 'All regions' : r, r)));

  function renderColleges(){
    const grid = document.getElementById('collegeGrid');
    const q = document.getElementById('collegeSearch').value.trim().toLowerCase();
    const regionVal = collegeRegionFilter.value;
    grid.innerHTML = '';

    let filtered = COLLEGES.filter(c => {
      if (regionVal !== 'ALL' && c.region !== regionVal) return false;
      if (!q) return true;
      const hay = (c.name + ' ' + c.code + ' ' + c.city + ' ' + c.region + ' ' + c.courses.join(' ')).toLowerCase();
      return hay.includes(q);
    });

    filtered = filtered.slice().sort((a,b) => a.tier - b.tier || a.name.localeCompare(b.name));
    const total = filtered.length;
    const shown = filtered.slice(0, 150);

    if (shown.length === 0){
      grid.innerHTML = '<div style="color:var(--ink-faint);font-size:14px;">No colleges match that search.</div>';
      document.getElementById('collegeResultCount').textContent = '';
      return;
    }

    shown.forEach((c, idx) => {
      const rankBadge = regionVal !== 'ALL'
        ? `<span class="rank-badge">#${idx+1} in ${c.region}</span>`
        : `<span class="tier-badge">Tier ${c.tier}</span>`;
      const card = document.createElement('div');
      card.className = 'college-card';
      card.innerHTML = `
        <div class="card-tags">
          <span class="code">${c.code}</span>
          ${rankBadge}
          <span class="region-tag">${c.region}</span>
        </div>
        <h3>${c.name}</h3>
        <div class="loc">${c.city}, Maharashtra · ${c.ownership}</div>
        <div class="course-chips">${c.courses.map(co => `<span class="chip">${co}</span>`).join('')}</div>
      `;
      grid.appendChild(card);
    });

    document.getElementById('collegeResultCount').textContent = `${total.toLocaleString('en-IN')} colleges` + (total > 150 ? ' (showing top 150, best to lowest)' : ', best to lowest');
  }
  document.getElementById('collegeSearch').addEventListener('input', renderColleges);
  collegeRegionFilter.addEventListener('change', renderColleges);
  renderColleges();

  /* =========================================================
     INIT
  ========================================================= */
  showView('view-home');
</script>

</body>
</html>
